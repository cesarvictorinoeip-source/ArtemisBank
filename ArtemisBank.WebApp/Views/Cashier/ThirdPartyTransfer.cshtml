@model ThirdPartyTransferViewModel

@{
    ViewData["Title"] = "Transferencia a Cuentas de Terceros";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="Deposit">Depósito</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="Withdrawal">Retiro</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="CreditCardPayment">Pago Tarjeta</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="LoanPayment">Pago Préstamo</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Cashier" asp-action="ThirdPartyTransfer">Transferencia</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Transferencia a Cuentas de Terceros</h3>
    <a asp-controller="Cashier" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger">
        @foreach (var error in Model.Errors)
        {
            <p class="mb-0">⚠ @error</p>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Cashier" asp-action="ThirdPartyTransfer" method="post">
            <div class="mb-3">
                <label asp-for="OriginAccountNumber" class="form-label fw-semibold">Número de Cuenta Origen</label>
                <input asp-for="OriginAccountNumber" class="form-control" placeholder="Ingrese el número de cuenta origen" />
                <span asp-validation-for="OriginAccountNumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold">Monto de la Transacción</label>
                <input asp-for="Amount" type="number" step="any" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DestinationAccountNumber" class="form-label fw-semibold">Número de Cuenta Destino</label>
                <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Ingrese el número de cuenta destino" />
                <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Cashier" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Continuar
                </button>
            </div>
        </form>
    </div>
</div>