@model SavingsAccountFormViewModel

@{
    ViewData["Title"] = "Configurar Cuenta de Ahorro";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Configurar Cuenta de Ahorro</h3>
    <a asp-controller="SavingsAccount" asp-action="AssignAccount" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>Cliente:</strong> @Model.ClientName
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger">
        @foreach (var error in Model.Errors)
        {
            <p class="mb-0">⚠ @error</p>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="SavingsAccount" asp-action="CreateAccount" method="post">
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientName" />

            <div class="mb-3">
                <label asp-for="InitialBalance" class="form-label fw-semibold">Balance Inicial</label>
                <input asp-for="InitialBalance" class="form-control" placeholder="0.00" />
                <small class="text-muted">Puede ser 0.</small>
                <span asp-validation-for="InitialBalance" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="SavingsAccount" asp-action="AssignAccount" class="btn btn-outline-secondary me-2">← Volver</a>
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Asignar Cuenta
                </button>
            </div>
        </form>
    </div>
</div>