@model CancelSavingsAccountViewModel

@{
    ViewData["Title"] = "Cancelar Cuenta de Ahorro";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Cancelar Cuenta de Ahorro</h3>
    <a asp-controller="SavingsAccount" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body p-4">
        <h5 class="fw-bold text-danger">¿Está seguro que desea cancelar la cuenta @Model.AccountNumber?</h5>
        <p class="text-muted">Esta acción no se puede deshacer.</p>

        @if (Model.Balance > 0)
        {
            <div class="alert alert-info">
                ℹ Esta cuenta tiene un balance de RD$ @Model.Balance.ToString("N2").
                El monto será transferido automáticamente a la cuenta principal del cliente.
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <form asp-controller="SavingsAccount" asp-action="ConfirmCancel" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AccountNumber" />
                <input type="hidden" asp-for="Balance" />
                <button type="submit" class="btn btn-danger">Aceptar</button>
            </form>
            <a asp-controller="SavingsAccount" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</div>