@model LoanFormViewModel

@{
    ViewData["Title"] = "Configurar Préstamo";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Configurar Préstamo</h3>
    <a asp-controller="Loan" asp-action="AssignLoan" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>Cliente:</strong> @Model.ClientName &nbsp;|&nbsp;
    <strong>Deuda promedio del sistema:</strong> RD$ @Model.AverageDebt.ToString("N2")
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger">
        @foreach (var error in Model.Errors)
        {
            <p class="mb-0">⚠ @error</p>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Loan" asp-action="CreateLoan" method="post">
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientName" />
            <input type="hidden" asp-for="AverageDebt" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="TermMonths" class="form-label fw-semibold">Plazo</label>
                    <select asp-for="TermMonths" class="form-select">
                        <option value="">Seleccione el plazo</option>
                        <option value="6">6 meses</option>
                        <option value="12">12 meses</option>
                        <option value="18">18 meses</option>
                        <option value="24">24 meses</option>
                        <option value="30">30 meses</option>
                        <option value="36">36 meses</option>
                        <option value="42">42 meses</option>
                        <option value="48">48 meses</option>
                        <option value="54">54 meses</option>
                        <option value="60">60 meses</option>
                    </select>
                    <span asp-validation-for="TermMonths" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Amount" class="form-label fw-semibold">Monto a Prestar</label>
                    <input asp-for="Amount" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="InterestRate" class="form-label fw-semibold">Tasa de Interés Anual (%)</label>
                    <input asp-for="InterestRate" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="InterestRate" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Loan" asp-action="AssignLoan" class="btn btn-outline-secondary me-2">← Volver</a>
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Asignar Préstamo
                </button>
            </div>
        </form>
    </div>
</div>