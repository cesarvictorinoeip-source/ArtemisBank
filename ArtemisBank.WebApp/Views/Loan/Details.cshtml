@using ArtemisBank.Core.Application.DTOs
@model LoanDto

@{
    ViewData["Title"] = "Detalle del Préstamo";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Tabla de Amortización</h3>
    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>No. Préstamo:</strong> @Model.LoanNumber &nbsp;|&nbsp;
    <strong>Monto:</strong> RD$ @Model.Amount.ToString("N2") &nbsp;|&nbsp;
    <strong>Tasa:</strong> @Model.InterestRate% &nbsp;|&nbsp;
    <strong>Plazo:</strong> @Model.TermMonths meses
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>#</th>
                    <th>Fecha de Pago</th>
                    <th>Monto Cuota</th>
                    <th>Estado</th>
                    <th>Atraso</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Installments.Count; i++)
                {
                    var installment = Model.Installments[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@installment.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>RD$ @installment.Amount.ToString("N2")</td>
                        <td>
                            @if (installment.IsPaid)
                            {
                                <span class="badge bg-success">Pagada</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                        </td>
                        <td>
                            @if (installment.IsLate)
                            {
                                <span class="badge bg-danger">Atrasada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Al día</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>