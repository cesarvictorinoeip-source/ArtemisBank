@model List<LoanViewModel>

@{
    ViewData["Title"] = "Gestión de Préstamos";
    var totalPages = (int)ViewBag.TotalPages;
    var currentPage = (int)ViewBag.CurrentPage;
    var statusFilter = (string)ViewBag.StatusFilter;
    var searchIdCard = (string)ViewBag.SearchIdCard;
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Gestión de Préstamos</h3>
    <a asp-controller="Loan" asp-action="AssignLoan" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3); border: none;">
        + Asignar Préstamo
    </a>
</div>

<!-- Filtros -->
<div class="row mb-3">
    <div class="col-md-4">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="idcard" value="@searchIdCard" class="form-control" placeholder="Buscar por cédula..." />
            <input type="hidden" name="status" value="@statusFilter" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </form>
    </div>
    <div class="col-md-3">
        <select class="form-select" onchange="filterByStatus(this.value)">
            <option value="">Todos</option>
            <option value="activos" selected="@(statusFilter == "activos")">Activos</option>
            <option value="completados" selected="@(statusFilter == "completados")">Completados</option>
        </select>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>No. Préstamo</th>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Cuotas</th>
                    <th>Pagadas</th>
                    <th>Pendiente</th>
                    <th>Tasa</th>
                    <th>Plazo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.LoanNumber</td>
                        <td>@loan.OwnerFullName</td>
                        <td>RD$ @loan.Amount.ToString("N2")</td>
                        <td>@loan.TotalInstallments</td>
                        <td>@loan.PaidInstallments</td>
                        <td>RD$ @loan.PendingAmount.ToString("N2")</td>
                        <td>@loan.InterestRate%</td>
                        <td>@loan.TermMonths meses</td>
                        <td>
                            @if (loan.IsLate)
                            {
                                <span class="badge bg-danger">En mora</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Al día</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Loan" asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-controller="Loan" asp-action="Edit" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-warning ms-1">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&status=@statusFilter&idcard=@searchIdCard">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterByStatus(status) {
            window.location.href = '?status=' + status + '&page=1&idcard=@searchIdCard';
        }
    </script>
}