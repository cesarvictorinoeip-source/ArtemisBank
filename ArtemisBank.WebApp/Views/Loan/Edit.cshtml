@using ArtemisBank.Core.Application.ViewModels
@model EditLoanViewModel

@{
    ViewData["Title"] = "Editar Préstamo";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Editar Préstamo</h3>
    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger">
        @foreach (var error in Model.Errors)
        {
            <p class="mb-0">⚠ @error</p>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Loan" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LoanNumber" />

            <div class="mb-3">
                <label class="form-label fw-semibold">No. Préstamo</label>
                <input type="text" class="form-control" value="@Model.LoanNumber" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="InterestRate" class="form-label fw-semibold">Tasa de Interés Anual (%)</label>
                <input asp-for="InterestRate" class="form-control" placeholder="0.00" />
                <span asp-validation-for="InterestRate" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>