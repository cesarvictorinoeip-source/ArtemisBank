@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ArtemisBank - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="login-card">
            <div class="text-center mb-4">
                <div class="bank-logo">Artemis<span>Bank</span></div>
                <p class="bank-subtitle mt-1">Banca en línea segura y confiable</p>
                <div class="login-divider mt-3"></div>
            </div>

            @if (Context.Request.Query.ContainsKey("message") && Context.Request.Query["message"] == "nopermiso")
            {
                <div class="alert alert-warning rounded-3">
                    ⚠ No tiene permiso para acceder a esta sección. Por favor inicie sesión.
                </div>
            }

            @if (Model.HasError)
            {
                <div class="alert alert-danger rounded-3">
                    @foreach (var error in Model.Errors)
                    {
                        <p class="mb-0">⚠ @error</p>
                    }
                </div>
            }

            <form asp-controller="Login" asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold text-secondary">Usuario</label>
                    <input asp-for="UserName" class="form-control" placeholder="Ingrese su usuario" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary">Contraseña</label>
                    <input asp-for="Password" class="form-control" placeholder="Ingrese su contraseña" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-login text-white">Iniciar Sesión</button>
                </div>
                <div class="text-center">
                    <a asp-controller="Login" asp-action="ForgotPassword" class="forgot-link">
                        ¿Olvidó su contraseña?
                    </a>
                </div>
            </form>
            <hr class="mt-4">
            <p class="text-center text-muted small mb-0">© 2025 ArtemisBank. Todos los derechos reservados.</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>