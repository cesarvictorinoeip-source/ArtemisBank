@model string
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ArtemisBank - Confirmar Cuenta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="login-card text-center">
            <div class="mb-4">
                <div class="bank-logo">Artemis<span>Bank</span></div>
                <div class="login-divider mt-3"></div>
            </div>
            <div class="mb-4">
                <h1 style="font-size: 4rem;">✅</h1>
                <h4 class="fw-bold" style="color: #1a3a6b;">Cuenta Confirmada</h4>
                <p class="text-muted">@Model</p>
            </div>
            <a asp-controller="Login" asp-action="Index" class="btn btn-login text-white">
                Ir al Login
            </a>
            <hr class="mt-4">
            <p class="text-center text-muted small mb-0">© 2025 ArtemisBank. Todos los derechos reservados.</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>