@using ArtemisBank.Core.Application.ViewModels
@model ExpressTransactionViewModel

@{
    ViewData["Title"] = "Confirmar Transacción Express";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Index">Home</a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            Transacciones
        </a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-controller="Client" asp-action="ExpressTransaction">Express</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="CardPayment">Tarjeta de crédito</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="LoanPayment">Préstamo</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="BeneficiaryTransaction">Beneficiarios</a></li>
        </ul>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Beneficiaries">Beneficiarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="CashAdvance">Avance de efectivo</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="TransferBetweenAccounts">Transferencia</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Confirmar Transacción Express</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
            <p><strong>Titular Cuenta Destino:</strong> @Model.DestinationOwnerFullName</p>
            <p><strong>Cuenta Destino:</strong> @Model.DestinationAccountNumber</p>
            <p class="mb-0"><strong>Monto:</strong> RD$ @Model.Amount.ToString("N2")</p>
        </div>
        <p class="text-muted">¿Está seguro que desea realizar esta transacción?</p>
        <div class="d-flex gap-2 mt-3">
            <form asp-controller="Client" asp-action="ProcessExpressTransaction" method="post">
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Confirmar
                </button>
            </form>
            <a asp-controller="Client" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</div>