@using ArtemisBank.Core.Application.DTOs
@model LoanDto

@{
    ViewData["Title"] = "Detalle de Préstamo";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Index">Home</a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            Transacciones
        </a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-controller="Client" asp-action="ExpressTransaction">Express</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="CardPayment">Tarjeta de crédito</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="LoanPayment">Préstamo</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="BeneficiaryTransaction">Beneficiarios</a></li>
        </ul>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Beneficiaries">Beneficiarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="CashAdvance">Avance de efectivo</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="TransferBetweenAccounts">Transferencia</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Tabla de Amortización</h3>
    <a asp-controller="Client" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>No. Préstamo:</strong> @Model.LoanNumber &nbsp;|&nbsp;
    <strong>Monto:</strong> RD$ @Model.Amount.ToString("N2") &nbsp;|&nbsp;
    <strong>Tasa:</strong> @Model.InterestRate% &nbsp;|&nbsp;
    <strong>Plazo:</strong> @Model.TermMonths meses
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>#</th>
                    <th>Fecha de Pago</th>
                    <th>Monto Cuota</th>
                    <th>Estado</th>
                    <th>Atraso</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Installments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay cuotas registradas.</td>
                    </tr>
                }
                @{
                    int counter = 1;
                }
                @foreach (var installment in Model.Installments)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@installment.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>RD$ @installment.Amount.ToString("N2")</td>
                        <td>
                            <span class="badge @(installment.IsPaid ? "bg-success" : "bg-warning text-dark")">
                                @(installment.IsPaid ? "Pagada" : "Pendiente")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(installment.IsLate ? "bg-danger" : "bg-success")">
                                @(installment.IsLate ? "En mora" : "Al día")
                            </span>
                        </td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
    </div>
</div>