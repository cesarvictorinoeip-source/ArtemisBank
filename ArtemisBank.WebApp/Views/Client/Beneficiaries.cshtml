@using ArtemisBank.Core.Application.ViewModels
@model List<BeneficiaryViewModel>

@{
    ViewData["Title"] = "Beneficiarios";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Index">Home</a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            Transacciones
        </a>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-controller="Client" asp-action="ExpressTransaction">Express</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="CardPayment">Tarjeta de crédito</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="LoanPayment">Préstamo</a></li>
            <li><a class="dropdown-item" asp-controller="Client" asp-action="BeneficiaryTransaction">Beneficiarios</a></li>
        </ul>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="Beneficiaries">Beneficiarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="CashAdvance">Avance de efectivo</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Client" asp-action="TransferBetweenAccounts">Transferencia</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Mis Beneficiarios</h3>
    <button class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);"
            data-bs-toggle="modal" data-bs-target="#addBeneficiaryModal">
        + Agregar Beneficiario
    </button>
</div>

@if (TempData["BeneficiaryError"] != null)
{
    <div class="alert alert-danger">@TempData["BeneficiaryError"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>Nombre</th>
                    <th>No. Cuenta</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No tiene beneficiarios registrados.</td>
                    </tr>
                }
                @foreach (var beneficiary in Model)
                {
                    <tr>
                        <td>@beneficiary.OwnerFullName</td>
                        <td>@beneficiary.AccountNumber</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="confirmDelete(@beneficiary.Id)">
                                Eliminar
                            </button>
                            <form id="deleteForm-@beneficiary.Id"
                                  asp-controller="Client" asp-action="DeleteBeneficiary"
                                  method="post" style="display:none;">
                                <input type="hidden" name="id" value="@beneficiary.Id" />
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Agregar Beneficiario -->
<div class="modal fade" id="addBeneficiaryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #0a1628, #1a3a6b);">
                <h5 class="modal-title text-white">Agregar Beneficiario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Client" asp-action="AddBeneficiary" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Número de Cuenta</label>
                        <input type="text" name="AccountNumber" class="form-control"
                               placeholder="Ingrese el número de cuenta" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn text-white"
                                style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                            Agregar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('¿Está seguro que desea eliminar este beneficiario?')) {
                document.getElementById('deleteForm-' + id).submit();
            }
        }
    </script>
}