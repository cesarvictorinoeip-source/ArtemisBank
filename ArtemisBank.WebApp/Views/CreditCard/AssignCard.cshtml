@model AssignCreditCardViewModel

@{
    ViewData["Title"] = "Asignar Tarjeta de Crédito";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Asignar Tarjeta de Crédito</h3>
    <a asp-controller="CreditCard" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>Deuda promedio del sistema:</strong> RD$ @Model.AverageDebt.ToString("N2")
</div>

<div class="mb-3">
    <input type="text" id="searchClient" class="form-control w-auto" placeholder="Buscar por cédula..." onkeyup="searchClient()" />
</div>

<form asp-controller="CreditCard" asp-action="SelectClient" method="post">
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle" id="clientTable">
                <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                    <tr>
                        <th>Seleccionar</th>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Deuda Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>
                                <input type="radio" name="clientId" value="@client.Id" />
                            </td>
                            <td class="idcard">@client.IdCard</td>
                            <td>@client.FullName</td>
                            <td>@client.Email</td>
                            <td>RD$ @client.TotalDebt.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
            Siguiente paso →
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function searchClient() {
            var input = document.getElementById('searchClient').value.toLowerCase();
            var rows = document.querySelectorAll('#clientTable tbody tr');
            rows.forEach(function(row) {
                var idcard = row.querySelector('.idcard').textContent.toLowerCase();
                row.style.display = idcard.includes(input) ? '' : 'none';
            });
        }
    </script>
}