@using ArtemisBank.Core.Application.DTOs
@model CreditCardDto

@{
    ViewData["Title"] = "Detalle de Tarjeta";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Consumos de Tarjeta</h3>
    <a asp-controller="CreditCard" asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="alert" style="background-color: #e8f0fe; border-left: 4px solid #1a3a6b;">
    <strong>No. Tarjeta:</strong> **** @Model.CardNumber.Substring(Model.CardNumber.Length - 4) &nbsp;|&nbsp;
    <strong>Límite:</strong> RD$ @Model.CreditLimit.ToString("N2") &nbsp;|&nbsp;
    <strong>Deuda:</strong> RD$ @Model.AmountOwed.ToString("N2") &nbsp;|&nbsp;
    <strong>Expiración:</strong> @Model.ExpirationDate
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Comercio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Consumptions.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No hay consumos registrados.</td>
                    </tr>
                }
                @foreach (var consumption in Model.Consumptions)
                {
                    <tr>
                        <td>@consumption.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>RD$ @consumption.Amount.ToString("N2")</td>
                        <td>@consumption.Commerce</td>
                        <td>
                            <span class="badge @(consumption.Status == "Aprobado" ? "bg-success" : "bg-danger")">
                                @consumption.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>