@model List<UserViewModel>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var roleFilter = Context.Request.Query["role"].ToString();
    var page = int.TryParse(Context.Request.Query["page"], out int p) ? p : 1;
    var pageSize = 20;

    var filteredUsers = string.IsNullOrEmpty(roleFilter)
        ? Model
        : Model.Where(u => u.UserType == roleFilter).ToList();

    var totalPages = (int)Math.Ceiling(filteredUsers.Count / (double)pageSize);
    var pagedUsers = filteredUsers.Skip((page - 1) * pageSize).Take(pageSize).ToList();
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Gestión de Usuarios</h3>
    <a asp-controller="Admin" asp-action="CreateUser" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3); border: none;">
        + Nuevo Usuario
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Filtro por rol -->
<div class="mb-3">
    <select class="form-select w-auto" onchange="filterByRole(this.value)">
        <option value="">Todos los roles</option>
        <option value="Administrador" selected="@(roleFilter == "Administrador")">Administrador</option>
        <option value="Cajero" selected="@(roleFilter == "Cajero")">Cajero</option>
        <option value="Cliente" selected="@(roleFilter == "Cliente")">Cliente</option>
    </select>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead style="background: linear-gradient(135deg, #0a1628, #1a3a6b); color: white;">
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Cédula</th>
                    <th>Correo</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in pagedUsers)
                {
                    <tr>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.UserName</td>
                        <td>@user.IdCard</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge" style="background-color: #1a3a6b;">@user.UserType</span>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (user.IsActive)
                            {
                                <a asp-controller="Admin" asp-action="DeactivateUser" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-danger ms-1"
                                   onclick="return confirm('¿Está seguro que desea desactivar este usuario?')">
                                    Desactivar
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Admin" asp-action="ActivateUser" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-success ms-1"
                                   onclick="return confirm('¿Está seguro que desea activar este usuario?')">
                                    Activar
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Paginación -->
        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" href="?page=@i&role=@roleFilter">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterByRole(role) {
            window.location.href = '?role=' + role + '&page=1';
        }
    </script>
}