@model SaveUserViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

@section NavLinks {
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">Gestión de Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Loan" asp-action="Index">Gestión de Préstamos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="CreditCard" asp-action="Index">Gestión de Tarjetas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="SavingsAccount" asp-action="Index">Gestión de Cuentas</a>
    </li>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold" style="color: #1a3a6b;">Crear Usuario</h3>
    <a asp-controller="Admin" asp-action="UserList" class="btn btn-outline-secondary">← Volver</a>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger rounded-3">
        @foreach (var error in Model.Errors)
        {
            <p class="mb-0">⚠ @error</p>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Admin" asp-action="CreateUser" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Ingrese el nombre" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                    <input asp-for="LastName" class="form-control" placeholder="Ingrese el apellido" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="IdCard" class="form-label fw-semibold">Cédula</label>
                    <input asp-for="IdCard" class="form-control" placeholder="Ingrese la cédula" />
                    <span asp-validation-for="IdCard" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Correo</label>
                    <input asp-for="Email" class="form-control" placeholder="Ingrese el correo" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold">Usuario</label>
                    <input asp-for="UserName" class="form-control" placeholder="Ingrese el usuario"
                           oninput="this.value = this.value.trim()" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UserType" class="form-label fw-semibold">Tipo de Usuario</label>
                    <select asp-for="UserType" class="form-select" id="userTypeSelect">
                        <option value="">Seleccione un tipo</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Cajero">Cajero</option>
                        <option value="Cliente">Cliente</option>
                    </select>
                    <span asp-validation-for="UserType" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Password" class="form-control" placeholder="Ingrese la contraseña" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirme la contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="row" id="initialAmountDiv" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label asp-for="InitialAmount" class="form-label fw-semibold">Monto Inicial</label>
                    <input asp-for="InitialAmount" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="InitialAmount" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Admin" asp-action="UserList" class="btn btn-outline-secondary me-2">Cancelar</a>
                <button type="submit" class="btn text-white" style="background: linear-gradient(135deg, #1a3a6b, #2196F3);">
                    Crear Usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const userTypeSelect = document.getElementById('userTypeSelect');
        const initialAmountDiv = document.getElementById('initialAmountDiv');

        userTypeSelect.addEventListener('change', function () {
            if (this.value === 'Cliente') {
                initialAmountDiv.style.display = 'flex';
            } else {
                initialAmountDiv.style.display = 'none';
            }
        });

        // Mostrar si ya viene seleccionado Cliente (en caso de error de validación)
        if (userTypeSelect.value === 'Cliente') {
            initialAmountDiv.style.display = 'flex';
        }
    </script>
}