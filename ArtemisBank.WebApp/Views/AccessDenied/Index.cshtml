@{
    Layout = null;
    ViewData["Title"] = "Acceso Denegado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ArtemisBank - Acceso Denegado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="login-card text-center">
            <div class="mb-4">
                <div class="bank-logo">Artemis<span>Bank</span></div>
                <div class="login-divider mt-3"></div>
            </div>
            <div class="mb-4">
                <h1 style="font-size: 5rem; color: #dc3545;">🚫</h1>
                <h3 class="fw-bold text-danger">Acceso Denegado</h3>
                <p class="text-muted">No tiene permiso para acceder a esta sección.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-grid gap-2">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-login text-white">
                            Volver al Home
                        </a>
                    }
                    else if (User.IsInRole("Cajero"))
                    {
                        <a asp-controller="Cashier" asp-action="Index" class="btn btn-login text-white">
                            Volver al Home
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Client" asp-action="Index" class="btn btn-login text-white">
                            Volver al Home
                        </a>
                    }
                </div>
            }
            else
            {
                <a asp-controller="Login" asp-action="Index" class="btn btn-login text-white">
                    Ir al Login
                </a>
            }
            <hr class="mt-4">
            <p class="text-center text-muted small mb-0">© 2025 ArtemisBank. Todos los derechos reservados.</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>